# =============================================================================
# Polybot environment template
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values:
#
#     cp .env.example .env
#     chmod 600 .env
#
# NEVER commit your real ".env" — it holds keys that control real money.
# ".env" is already gitignored; only THIS template (.env.example) is tracked.
# Replace every <...> placeholder. Do not share or screenshot the filled file.
# =============================================================================

# --- Path A: bridge wallet (auto-created by scripts/generate_wallet.py) -------
# generate_wallet.py writes PRIVATE_KEY + WALLET_ADDRESS + the lines below.
# This wallet only receives/forwards funds; it does NOT place bets.
PRIVATE_KEY=<your bridge wallet private key — generated by generate_wallet.py>
WALLET_ADDRESS=<your bridge wallet address — generated by generate_wallet.py>

# These are public, non-secret defaults — safe to keep as-is.
CHAIN_ID=137
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# L2 API credentials for the bridge wallet signer (Path A — legacy EOA).
# Auto-derived by scripts/prepare_live.py. Unused on new accounts (Path B).
# Leave blank unless you are on a grandfathered EOA setup.
CLOB_API_KEY=<auto-derived by prepare_live.py — leave blank to start>
CLOB_API_SECRET=<auto-derived by prepare_live.py — leave blank to start>
CLOB_API_PASSPHRASE=<auto-derived by prepare_live.py — leave blank to start>

# --- Path B: deposit wallet (Polymarket-deployed via MetaMask) ---------------
# Fill these three in manually after signing up on polymarket.com with MetaMask
# and clicking "Enable trading" (see README Section 6).
# The moment all three are present, the bot uses this (correct) betting path.
MM_PRIVATE_KEY=<your MetaMask account private key — MOST SENSITIVE>
MM_WALLET_ADDRESS=<your MetaMask account address>
DEPOSIT_WALLET=<your Polymarket deposit wallet address (from the deposit screen)>

# L2 API credentials for the MetaMask signer.
# Auto-created and written here by scripts/prepare_live_b.py — leave blank now.
MM_CLOB_API_KEY=<auto-created by prepare_live_b.py — leave blank to start>
MM_CLOB_API_SECRET=<auto-created by prepare_live_b.py — leave blank to start>
MM_CLOB_API_PASSPHRASE=<auto-created by prepare_live_b.py — leave blank to start>
